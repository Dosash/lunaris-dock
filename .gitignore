# Track project sources only. Profiles, recordings, logs and local builds stay local.
*
!/.gitignore
!/LICENSE
!/README.md
!/AGENTS.md
!/docs/
!/docs/DEVELOPMENT.md
!/docs/screenshots/
!/docs/screenshots/dock.png
!/docs/screenshots/start.png
!/docs/screenshots/settings.png
!/build.ps1
!/src/
!/src/Platform/
!/src/UI/
!/src/**/*.cs
!/src/UI/Preferences.xaml
!/src/App.config
!/src/app.manifest
!/src/LunarisDock.ico
!/scripts/
!/scripts/*.ps1
!/packaging/
!/packaging/Lunaris.iss
!/packaging/portable/
!/packaging/portable/README.txt
!/packaging/portable/Тестовый запуск.cmd
!/qa/
!/qa/*.cs
!/qa/*.ps1
!/tests/
