<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="MenuRow" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="9,5"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Button">
        <Border x:Name="face" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="face" Property="Background" Value="{DynamicResource MenuHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="face" Property="Background" Value="{DynamicResource MenuSelection}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource MenuAccent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>

  <Style TargetType="GroupBox">
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="GroupBox">
        <StackPanel>
          <ContentPresenter ContentSource="Header" Margin="4,2,4,4" TextElement.FontWeight="SemiBold"
                            TextElement.Foreground="{DynamicResource MenuText}"/>
          <ContentPresenter/>
        </StackPanel>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>

  <Style x:Key="MenuSwitch" TargetType="CheckBox">
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="CheckBox">
        <Border x:Name="row" Background="Transparent" BorderBrush="Transparent" CornerRadius="8" BorderThickness="1" Padding="4,3">
          <DockPanel>
            <Grid DockPanel.Dock="Right" Width="34" Height="20" Margin="12,0,0,0" VerticalAlignment="Center">
              <Border x:Name="well" Background="{DynamicResource MenuSwitchOff}" CornerRadius="10"/>
              <Border x:Name="thumb" Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0"
                      CornerRadius="8" Background="{DynamicResource MenuKnob}">
                <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity=".20"/></Border.Effect>
              </Border>
            </Grid>
            <ContentPresenter VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="well" Property="Background" Value="{DynamicResource MenuActive}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="row" Property="Opacity" Value=".62"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource MenuHover}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource MenuAccent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>

  <Style x:Key="VolumeRailButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="MenuVolume" TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Slider">
        <Border x:Name="outline" BorderBrush="Transparent" BorderThickness="1" CornerRadius="15" Padding="2">
          <Grid Height="26" Background="Transparent">
            <Border Height="14" VerticalAlignment="Center" Background="{DynamicResource MenuRail}" CornerRadius="7"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="14" CornerRadius="7" VerticalAlignment="Center"
                        Margin="0,0,-12,0" Background="{DynamicResource MenuActive}"/></Grid>
                  </ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource VolumeRailButton}"/></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="24" Height="24"><Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Border Margin="1" CornerRadius="11" Background="{DynamicResource MenuKnob}"
                          BorderThickness="1" BorderBrush="{DynamicResource MenuKnobEdge}">
                    <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity=".22"/></Border.Effect>
                  </Border>
                </ControlTemplate></Thumb.Template></Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="outline" Property="BorderBrush" Value="{DynamicResource MenuAccent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="9"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent" Margin="2,2,1,2">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource VolumeRailButton}"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb MinHeight="20"><Thumb.Template><ControlTemplate TargetType="Thumb">
              <Border Background="{DynamicResource MenuSwitchOff}" Opacity=".8" CornerRadius="3"/>
            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource VolumeRailButton}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
